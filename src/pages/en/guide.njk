{#- English twin of src/pages/guide.njk (phase E1, decision of 2026-10-10).
    Same structure, same ids, same data-mesure. The keyboard component is
    bilingual: `clavierEn` (src/_data/clavierEn.js) is the English view of
    the same data, and the v2/clavier.njk macros and js/v2/clavier.js write
    their own words in English from it and from <html lang="en">. -#}
{% from "v2/clavier.njk" import parcours, aideMemoire, feuilleImpression, dessin %}

{#- Glyphs that a monospaced font renders alike carry their name, and those
    that have a page link to it. The character pages exist in French only: the
    link goes to the French page, flagged for screen readers (decision of
    2026-10-01). -#}
{%- set nomsGlyphes = {
  "–": "En dash",
  "—": "Em dash",
  "‑": "Non-breaking hyphen",
  "ẞ": "Capital ß"
} -%}
{%- set pagesGlyphes = {
  "É": "/e-aigu-majuscule", "È": "/e-grave-majuscule", "À": "/a-grave-majuscule", "Ç": "/c-cedille-majuscule",
  "œ": "/e-dans-l-o", "Œ": "/e-dans-l-o", "æ": "/e-dans-l-a", "Æ": "/e-dans-l-a",
  "«": "/guillemets", "»": "/guillemets", "—": "/tiret-cadratin", "@": "/arobase",
  "{": "/accolades", "}": "/accolades", "[": "/crochets", "]": "/crochets"
} -%}
{%- macro celluleGlyphe(glyphe, noms, pages) -%}
  {%- set nomme = glyphe.morte or glyphe.invisible -%}
  {%- set nom = noms[glyphe.texte] if not nomme else null -%}
  {%- set lienGlyphe = pages[glyphe.texte] if not nomme else null -%}
  <th role="rowheader" scope="row" class="memo-table__glyphe{% if nomme or nom %} memo-table__glyphe--nomme{% endif %}">
    {%- if lienGlyphe %}<a href="{{ lienGlyphe }}" hreflang="fr">{% endif -%}
    {%- if nomme -%}{{ glyphe.nom }}
    {%- elif nom -%}<span class="memo-table__symbole" aria-hidden="true">{{ glyphe.texte }}</span> {{ nom }}
    {%- else -%}{{ glyphe.texte }}{%- endif -%}
    {%- if lienGlyphe %}<span class="visuellement-cache"> (in French)</span></a>{% endif -%}
  </th>
{%- endmacro %}

{#- The page teaches, the full screen is the reference (contract of
    2026-08-29). Everything the page draws comes from src/_data/clavierEn.js and
    the signature table from src/_data/verifInstallation.js: no position and no
    keystroke is written here.

    ⚠️ The hero is calibrated: the bottom of the keyboard must stay above the
    fold of a 900 px window. Any line added here pushes it down. -#}

  <section class="hero-guide">
    <div class="conteneur">
      <h1>Get started with AZERTY&nbsp;Global</h1>
      <p class="hero-guide__definition">The five changes, the added characters and the keys to type them.</p>

      <nav class="sommaire" aria-label="Page sections">
        <a class="sommaire__chip" href="#changements">Five changes</a>
        <a class="sommaire__chip" href="#memo">New characters</a>
        <a class="sommaire__chip" href="#aide-memoire">Cheat sheet</a>
        <a class="sommaire__chip" href="#transition">Transition</a>
        <a class="sommaire__chip" href="#installer">Install</a>
      </nav>
    </div>
  </section>

  <section class="section section--suite-heros" id="changements">
    <div class="conteneur">
      <h2>The five changes</h2>

      {{ parcours(clavierEn, "guide-parcours") }}

      {#- The reassurance comes after the demonstration: placed before the
          keyboard, it pushed the drawing below the fold. -#}
      <div class="prose guide-assurance">
        <p>
          Everything else stays put: the letters A to Z, the accented letters (except
          <kbd>ù</kbd>) and the vast majority of symbols. The share of keystrokes affected is
          1.01% on the frequencies of the AFNOR corpus (half formal, half informal text,
          <a href="/en/comparison#methode-comparatif">method</a>), so 99% of the keystrokes in a
          French text are unchanged.
        </p>
      </div>
    </div>
  </section>

  <section class="section" id="memo">
    <div class="conteneur">
      <h2>The new-characters memo</h2>

      <h3 class="memo-titre">What to memorize</h3>
      <div class="prose">
        <p class="texte-2">
          The characters of the five changes and how to type them.
        </p>
      </div>

      {#- One keystroke per character and no "before" column: Antoine's choice
          on three rendered mock-ups, 2026-09-19. The first keystroke of `apres`
          is the direct route; the alternatives stay in the full-screen cheat
          sheet. #}
      <div class="memo-grille memo-grille--flux">
        {%- for groupe in clavierEn.memoire %}
        <div class="tableau-compare tableau-compare--compact memo-table">
          <table role="table">
            <caption>{{ loop.index }}. {{ groupe.titre }}</caption>
            <thead role="rowgroup">
              <tr role="row">
                <th role="columnheader" scope="col">Character</th>
                <th role="columnheader" scope="col">Keystroke</th>
              </tr>
            </thead>
            <tbody role="rowgroup">
              {%- for entree in groupe.entrees %}
              <tr role="row">
                {{ celluleGlyphe(entree.glyphe, nomsGlyphes, pagesGlyphes) }}
                <td role="cell" data-colonne="Keystroke">{% for morceau in entree.apres[0].split(" + ") %}{% if not loop.first %} + {% endif %}<kbd>{{ morceau }}</kbd>{% endfor %}</td>
              </tr>
              {%- endfor %}
            </tbody>
          </table>
        </div>
        {%- endfor %}
      </div>

      {#- Additions already seen in the five changes (` and ~ in change 4) are
          not repeated here. The data and the A4 sheet stay complete. #}
      {%- set dejaVus = [] -%}
      {%- for groupe in clavierEn.memoire -%}
        {%- for entree in groupe.entrees -%}{%- if dejaVus.push(entree.valeur) -%}{%- endif -%}{%- endfor -%}
      {%- endfor -%}
      {%- set famillesRestantes = [] -%}
      {%- set autresAjouts = [] -%}
      {%- for famille in clavierEn.memoFamilles -%}
        {%- set restes = [] -%}
        {%- for entree in famille.entrees -%}
          {%- if not (entree.valeur in dejaVus) -%}
            {%- if restes.push(entree) -%}{%- endif -%}
            {%- if autresAjouts.push(entree) -%}{%- endif -%}
          {%- endif -%}
        {%- endfor -%}
        {%- if restes.length -%}{%- if famillesRestantes.push({ "titre": famille.titre, "entrees": restes }) -%}{%- endif -%}{%- endif -%}
      {%- endfor %}

      <h3 class="memo-titre">The {{ autresAjouts | length }} other characters added</h3>
      <div class="prose">
        <p class="texte-2">
          These characters are in addition to those of traditional AZERTY.
        </p>
      </div>

      {#- One family per accordion: open in the HTML, so on desktop and without
          a script; js/v2/guide.js closes them below 768 px. -#}
      <div class="memo-grille memo-grille--triple">
        {%- for famille in famillesRestantes %}
        <details class="notice memo-famille" open data-memo-famille>
          <summary>{{ famille.titre }}</summary>
          <div class="notice__contenu">
          <div class="tableau-compare tableau-compare--compact memo-table">
            <table role="table">
              <caption class="visuellement-cache">{{ famille.titre }}</caption>
              <thead role="rowgroup">
                <tr role="row">
                  <th role="columnheader" scope="col">Character</th>
                  <th role="columnheader" scope="col">Keystroke</th>
                </tr>
              </thead>
              <tbody role="rowgroup">
                {%- for entree in famille.entrees %}
                <tr role="row">
                  {{ celluleGlyphe(entree.glyphe, nomsGlyphes, pagesGlyphes) }}
                  <td role="cell" data-colonne="Keystroke">{% for morceau in entree.frappe.split(" + ") %}{% if not loop.first %} + {% endif %}<kbd>{{ morceau }}</kbd>{% endfor %}</td>
                </tr>
                {%- endfor %}
              </tbody>
            </table>
          </div>
          </div>
        </details>
        {%- endfor %}
      </div>

      {#- Dead keys are folded away: they open whole tables (Greek, Cyrillic,
          phonetic alphabet) that concern only a fraction of readers
          (Antoine's choice, 2026-08-30). -#}
      <details class="notice memo-mortes">
        <summary>The {{ clavierEn.memo.touchesMortes | length }} new dead keys: rare accents, alphabets and symbols</summary>
        <div class="notice__contenu">
          <div class="prose">
            <p>
              A dead key does not appear on its own: it accents or transforms the letter typed
              right after it. This is what opens Greek, Cyrillic, the phonetic alphabet and
              scientific symbols.
            </p>
          </div>
          <p class="memo-mortes__legende">Each dead key's symbol, then the keystroke.</p>
          {%- set lots = clavierEn.memo.touchesMortes | batch(9) %}
          <div class="memo-grille memo-grille--triple">
            {%- for lot in lots %}
            <div class="tableau-compare tableau-compare--compact memo-table">
              <table role="table">
                <caption class="visuellement-cache">Dead keys, part {{ loop.index }} of {{ lots | length }}</caption>
                <thead role="rowgroup">
                  <tr role="row">
                    <th role="columnheader" scope="col">Dead key</th>
                    <th role="columnheader" scope="col">Keystroke</th>
                  </tr>
                </thead>
                <tbody role="rowgroup">
                  {%- for entree in lot %}
                  {#- A combining mark (U+0300 to U+036F) has no width: alone, it
                      lands on the next letter. It gets its conventional
                      support, the dotted circle U+25CC. -#}
                  {%- set point = entree.glyphe.texte.codePointAt(0) %}
                  <tr role="row">
                    <th role="rowheader" scope="row" class="memo-table__glyphe memo-table__glyphe--nomme"><span class="memo-table__symbole" aria-hidden="true">{% if point >= 768 and point <= 879 %}&#9676;{% endif %}{{ entree.glyphe.texte }}</span> {{ entree.glyphe.nom }}</th>
                    <td role="cell" data-colonne="Keystroke">{% for morceau in entree.frappe.split(" + ") %}{% if not loop.first %} + {% endif %}<kbd>{{ morceau }}</kbd>{% endfor %}</td>
                  </tr>
                  {%- endfor %}
                </tbody>
              </table>
            </div>
            {%- endfor %}
          </div>
        </div>
      </details>
    </div>
  </section>

  <section class="section" id="aide-memoire">
    <div class="conteneur">
      <h2>The cheat sheet</h2>
      <div class="prose">
        <p>
          The complete keyboard, layer by layer, to keep open during the first few days. The
          printed sheet and the PDF carry the same content: the overview, the five changes
          and the memo, on one landscape A4 page.
        </p>
      </div>

      {#- The reference keyboard in the page, layer tabs and search below it:
          the drawing keeps its size and does not move when the list grows. -#}
      {{ dessin(clavierEn, "guide-clavier", reglage=clavierEn.reglages.guide) }}

      {{ aideMemoire(clavierEn, "guide-aide", "/assets/aide-memoire-azerty-global.pdf") }}
    </div>
  </section>

  <section class="section" id="transition">
    <div class="conteneur">
      <h2>A smooth transition</h2>

      <div class="cartes-transition">
        <div class="carte carte-transition">
          <p class="carte-transition__glyphe" aria-hidden="true">É</p>
          <h3>Find the keys on the cheat sheet</h3>
          <p>
            Keep the cheat sheet above within reach to find the accents and symbols.
            The letters A to Z stay where they are.
          </p>
        </div>

        <div class="carte carte-transition">
          <p class="carte-transition__glyphe" aria-hidden="true">A</p>
          <h3>Keep your keyboard</h3>
          <p>
            AZERTY Global is a software layout: nothing to buy, and the stickers are
            optional. Your current AZERTY keyboard works as is.
          </p>
        </div>

        <div class="carte carte-transition">
          <p class="carte-transition__glyphe" aria-hidden="true">⇄</p>
          <h3>Switching back stays easy</h3>
          <p>
            Moving between a computer on AZERTY Global and one on traditional AZERTY takes
            almost no effort: letters and digits are in the same place, and only the five
            changes differ.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="section" id="installer">
    <div class="conteneur">
      <h2>Install and check</h2>
      <div class="prose">
        <p>
          Depending on the channel, AZERTY Global is either added to the system's keyboards (EXE
          installer, macOS, Linux) or runs as an application that transforms what your keys send
          (Microsoft Store, MSIX kit). What you type is the same either way. The complete
          instructions, with screenshots, are on <a href="/en/download?cid=website_guide">the
          download page</a>; here are the essentials.
        </p>
      </div>

      {#- Same pattern as /download (shared `.selecteur-os` component): the
          detection picks the open tab, it redirects nothing and starts no
          download.
          ⚠️ Deliberate difference from /download: the three panels ship WITHOUT
          `hidden` and the script folds the inactive ones, so a reader without
          a script still sees the macOS and Linux instructions. -#}
      <div class="selecteur-os" role="tablist" aria-label="Operating system">
        <button type="button" class="selecteur-os__onglet" id="guide-tab-windows" role="tab"
                aria-controls="guide-os-windows" aria-selected="true" data-os="windows">Windows</button>
        <button type="button" class="selecteur-os__onglet" id="guide-tab-macos" role="tab"
                aria-controls="guide-os-macos" aria-selected="false" tabindex="-1" data-os="macos">macOS</button>
        <button type="button" class="selecteur-os__onglet" id="guide-tab-linux" role="tab"
                aria-controls="guide-os-linux" aria-selected="false" tabindex="-1" data-os="linux">Linux</button>
      </div>

      <div id="guide-os-windows" role="tabpanel" aria-labelledby="guide-tab-windows" tabindex="0">
        <details class="notice">
          <summary>Microsoft Store app</summary>
          <div class="notice__contenu prose">
            <p>
              Recommended for a personal computer: no administrator rights, no SmartScreen
              warning, automatic updates.
            </p>
            <p>
              After installing, click “Open”. AZERTY Global starts in the taskbar, near the
              clock, and a welcome window walks you through the first steps. To find it later,
              type <strong>AZERTY</strong> in the Start menu.
            </p>
            <p>
              Turn it on or pause it at any time with
              <kbd>Ctrl</kbd> + <kbd>Shift</kbd> + <kbd>Caps&nbsp;Lock</kbd>, or by right-clicking
              the AG icon.
            </p>
            <p><a href="/en/download?cid=website_guide#installation">Download and see the detailed instructions</a></p>
          </div>
        </details>

        <details class="notice">
          <summary>Enterprise kit (signed MSIX)</summary>
          <div class="notice__contenu prose">
            <p>
              For a managed computer, a blocked Microsoft Store or a fleet deployment. The ZIP kit
              contains the MSIX package signed by the Association pour la Modernisation du Clavier
              Français, a deployment sheet (in French) and the printable materials.
            </p>
            <p>
              Open the downloaded file, check that the publisher shown is the association, then
              install. The download page gives the SHA-256 checksum to compare.
            </p>
            <p><a href="/en/download?cid=website_guide#installation">Download the kit and check the checksum</a></p>
          </div>
        </details>

        <details class="notice">
          <summary>Classic EXE installer</summary>
          <div class="notice__contenu prose">
            <p>
              The option that adds AZERTY Global to the list of Windows keyboards. It requires
              administrator rights and may show a SmartScreen warning.
            </p>
            <p>
              Once installed: click <strong>FRA</strong> in the taskbar and choose AZERTY
              Global, or switch keyboards with <kbd>Win</kbd> + <kbd>Space</kbd>.
            </p>
            <p><a href="/en/download?cid=website_guide#exe-classique">The complete steps, and why SmartScreen appears</a></p>
          </div>
        </details>
      </div>

      <div id="guide-os-macos" role="tabpanel" aria-labelledby="guide-tab-macos" tabindex="0">
        <details class="notice">
          <summary>Install on macOS</summary>
          <div class="notice__contenu prose">
            <p>
              Copy the file <code>AZERTY Global.keylayout</code> to
              <code>~/Library/Keyboard Layouts/</code>, then log out and back in. This step is
              required for macOS to detect the file.
            </p>
            <p>
              Then turn the keyboard on in System Settings → Keyboard → Text Input → Edit… →
              “+” → AZERTY Global (before macOS 13: System Preferences → Keyboard → Input
              Sources).
            </p>
            <p>
              To switch between keyboards, use the keyboard icon in the menu bar, or
              <kbd>Ctrl</kbd> + <kbd>Space</kbd>.
            </p>
            <p><a href="/en/download?cid=website_guide#installation">Download and see the five steps</a></p>
          </div>
        </details>
      </div>

      <div id="guide-os-linux" role="tabpanel" aria-labelledby="guide-tab-linux" tabindex="0">
        <details class="notice">
          <summary>Install on Linux</summary>
          <div class="notice__contenu prose">
            <p>
              Unzip the archive, then run the installation script
              (<code>chmod +x install.sh</code> then <code>sudo ./install.sh</code>). Log out and
              back in.
            </p>
            <p>
              Finally, add “French (AZERTY Global)” to your input sources: GNOME → Settings →
              Keyboard → Input Sources; KDE → System Settings → Keyboard → Layouts.
            </p>
            <p><a href="/en/download?cid=website_guide#installation">Download and see the commands</a></p>
          </div>
        </details>
      </div>

      <div class="message prose">
        <span class="message__titre">Check that it is active</span>
        Open a text editor and press the key marked
        <kbd>{{ verifInstallation.marquage }}</kbd>: it should type a period.
      </div>

      <h3 class="aide-transverse">Need help?</h3>
      <p class="aide-transverse__liens">
        <a href="/en/faq">FAQ and troubleshooting</a> ·
        <a href="/en/compatibility">Compatibility</a> ·
        <a href="/en/contact">Contact</a>
      </p>
    </div>
  </section>

  <section class="section">
    <div class="conteneur">
      <h2>What's next?</h2>
      <div class="etapes-suivantes">
        {#- The tester exists in French only: the card goes to the French page
