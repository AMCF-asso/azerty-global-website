              <td role="cell" data-colonne="Traditional AZERTY"><span class="valeur--non">Alt + number codes</span></td>
              <td role="cell" data-colonne="AFNOR AZERTY"><span class="valeur--oui">Dead keys</span></td>
            </tr>
