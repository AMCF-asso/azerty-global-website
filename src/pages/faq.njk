                  <caption>Caractères africains et frappe exacte.</caption>
                  <thead role="rowgroup">
                    <tr role="row">
                      <th role="columnheader" scope="col">Caractère</th>
                      <th role="columnheader" scope="col">Comment le taper</th>
                      <th role="columnheader" scope="col">Langues</th>
                    </tr>
                  </thead>
                  <tbody role="rowgroup">
                    <tr role="row">
                      <th role="rowheader" scope="row"><strong>ɛ Ɛ</strong> — e ouvert</th>
                      <td role="cell" data-colonne="Comment le taper">Touche morte Latin étendu puis <kbd>E</kbd> ou <kbd>Maj</kbd> + <kbd>E</kbd></td>
                      <td role="cell" data-colonne="Langues">Bambara, ewé, fon, dioula, lingala</td>
                    </tr>
                    <tr role="row">
                      <th role="rowheader" scope="row"><strong>ɔ Ɔ</strong> — o ouvert</th>
                      <td role="cell" data-colonne="Comment le taper">Touche morte Latin étendu puis <kbd>O</kbd> ou <kbd>Maj</kbd> + <kbd>O</kbd></td>
                      <td role="cell" data-colonne="Langues">Bambara, ewé, fon, dioula, lingala</td>
                    </tr>
                    <tr role="row">
                      <th role="rowheader" scope="row"><strong>ŋ Ŋ</strong> — eng</th>
                      <td role="cell" data-colonne="Comment le taper">Touche morte Latin étendu puis <kbd>N</kbd> ou <kbd>Maj</kbd> + <kbd>N</kbd></td>
                      <td role="cell" data-colonne="Langues">Wolof, bambara, peul, haoussa, ewé</td>
                    </tr>
                    <tr role="row">
                      <th role="rowheader" scope="row"><strong>ɲ Ɲ</strong> — n palatal</th>
                      <td role="cell" data-colonne="Comment le taper">Touche morte Latin étendu puis <kbd>J</kbd> ou <kbd>Maj</kbd> + <kbd>J</kbd></td>
                      <td role="cell" data-colonne="Langues">Bambara, peul, wolof, dioula</td>
                    </tr>
                    <tr role="row">
                      <th role="rowheader" scope="row"><strong>ɓ Ɓ</strong> — b implosif</th>
                      <td role="cell" data-colonne="Comment le taper">Touche morte Crochet puis <kbd>B</kbd> ou <kbd>Maj</kbd> + <kbd>B</kbd></td>
                      <td role="cell" data-colonne="Langues">Peul, haoussa</td>
                    </tr>
                    <tr role="row">
                      <th role="rowheader" scope="row"><strong>ɗ Ɗ</strong> — d implosif</th>
