            <li class="dev-ceinture__item"><span class="dev-ceinture__symbole" aria-hidden="true">&#92;</span><span class="dev-ceinture__nom">Antislash</span><span class="dev-ceinture__combo"><kbd>AltGr</kbd> + <kbd>G</kbd></span></li>
            <li class="dev-ceinture__item"><span class="dev-ceinture__symbole" aria-hidden="true">|</span><span class="dev-ceinture__nom">Barre verticale</span><span class="dev-ceinture__combo"><kbd>AltGr</kbd> + <kbd>H</kbd></span></li>
            <li class="dev-ceinture__item"><span class="dev-ceinture__symbole" aria-hidden="true">[</span><span class="dev-ceinture__nom">Crochet ouvrant</span><span class="dev-ceinture__combo"><kbd>AltGr</kbd> + <kbd>J</kbd></span></li>
            <li class="dev-ceinture__item"><span class="dev-ceinture__symbole" aria-hidden="true">]</span><span class="dev-ceinture__nom">Crochet fermant</span><span class="dev-ceinture__combo"><kbd>AltGr</kbd> + <kbd>K</kbd></span></li>
          </ul>
          <p class="dev-ceinture__suite">Tout sur <a href="/accolades">les accolades</a> et <a href="/crochets">les crochets</a>.</p>
