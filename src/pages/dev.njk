    <!-- Le détail des raccourcis -->
    <section class="section">
      <div class="container container--narrow">
        <div class="section__header">
          <h2 class="section__title">Le détail des raccourcis</h2>
        </div>

        <div class="card">
          <h3 class="card__title">La ceinture de code</h3>
          <p class="card__text">Les symboles qui structurent le code, regroupés sur la rangée de repos et atteignables sans bouger les mains — avec <kbd>AltGr</kbd> :</p>
          <ul class="dev-shortcut-list">
            <li><a href="/accolades"><kbd>AltGr</kbd> + <kbd>D</kbd> = <kbd>{</kbd> · <kbd>AltGr</kbd> + <kbd>F</kbd> = <kbd>}</kbd></a></li>
            <li><a href="/crochets"><kbd>AltGr</kbd> + <kbd>J</kbd> = <kbd>[</kbd> · <kbd>AltGr</kbd> + <kbd>K</kbd> = <kbd>]</kbd></a></li>
            <li><kbd>AltGr</kbd> + <kbd>G</kbd> = <kbd>&#92;</kbd> · <kbd>AltGr</kbd> + <kbd>H</kbd> = <kbd>|</kbd></li>
          </ul>
        </div>

        <div class="card mt-4">
          <h3 class="card__title">Les symboles optimisés</h3>
          <p class="card__text">Les caractères les plus utiles au code, ramenés à une position naturelle :</p>
          <ul class="dev-shortcut-list">
            <li><a href="/arobase"><kbd>@</kbd> en accès direct</a> (touche en haut à gauche)</li>
            <li><kbd>#</kbd> sur <kbd>Maj</kbd> + <kbd>@</kbd>, ou <kbd>AltGr</kbd> + <kbd>:</kbd> pour les développeurs</li>
            <li><kbd>^</kbd> sur <kbd>AltGr</kbd> + <kbd>I</kbd> — l’accent circonflexe seul (caret), sans touche morte</li>
            <li><kbd>`</kbd> sur <kbd>AltGr</kbd> + <kbd>L</kbd></li>
            <li><kbd>~</kbd> sur <kbd>AltGr</kbd> + <kbd>N</kbd></li>
            <li><kbd>&lt;</kbd> <kbd>&gt;</kbd> en accès direct sur la touche dédiée (ou <kbd>AltGr</kbd> + <kbd>,</kbd> / <kbd>AltGr</kbd> + <kbd>;</kbd> sur clavier ANSI)</li>
          </ul>
        </div>
      </div>
    </section>

