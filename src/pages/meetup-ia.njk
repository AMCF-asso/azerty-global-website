<header class="meetup-entete">
  <div class="meetup-conteneur meetup-entete-ligne">
    <a class="meetup-logo" href="/"><picture><source srcset="assets/logo-azerty-global-header.webp" type="image/webp"><img src="assets/logo-azerty-global-header.png" alt="AZERTY Global, accueil du site" width="480" height="250"></picture></a>
