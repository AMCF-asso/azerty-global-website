    <!-- Hero -->
    <section class="hero pb-8">
      <div class="container container--narrow">
        <h1 class="hero__title">L’association</h1>
        <p class="hero__subtitle">
          L’Association pour la Modernisation du Clavier Français est une association loi 1901, sans but lucratif et
          entièrement bénévole. Elle porte AZERTY Global et tout ce que le projet publie.
        </p>
      </div>
