                    <option value="azerty-fr">AZERTY de France</option>
                    <option value="azerty-be">AZERTY de Belgique</option>
                    <option value="qwerty">QWERTY</option>
                    <option value="qwertz">QWERTZ</option>
                    <option value="autre">Autre</option>
                    <option value="ne-sais-pas">Je ne sais pas</option>
                  </select>
                </div>
                <fieldset class="champ">
                  <legend class="champ__intitule">Type de clavier</legend>
                  <div class="choix choix--colonnes">
                    <div class="choix__option"><input class="saisie--case" type="checkbox" id="t-portable" name="type_clavier" value="portable"><label for="t-portable">Ordinateur portable</label></div>
                    <div class="choix__option"><input class="saisie--case" type="checkbox" id="t-bureau" name="type_clavier" value="bureau"><label for="t-bureau">Clavier de bureau</label></div>
                    <div class="choix__option"><input class="saisie--case" type="checkbox" id="t-sansfil" name="type_clavier" value="sans-fil"><label for="t-sansfil">Sans fil</label></div>
                    <div class="choix__option"><input class="saisie--case" type="checkbox" id="t-meca" name="type_clavier" value="mecanique"><label for="t-meca">Mécanique</label></div>
                  </div>
                </fieldset>
              </div>
            </fieldset>

            <fieldset class="formulaire__groupe">
              <legend class="formulaire__legende">Jusqu’à quel prix&#8239;?</legend>
              <p class="champ__aide">Aucun prix n’est fixé. Ces réponses servent à discuter avec l’imprimeur et le fabricant.</p>
              <div class="formulaire__rangee">
                <fieldset class="champ">
                  <legend class="champ__intitule">Pour les autocollants</legend>
                  <div class="choix">
                    <div class="choix__option"><input class="saisie--case" type="radio" id="pa-5" name="prix_autocollants" value="jusqu-5"><label for="pa-5">Jusqu’à 5&nbsp;€</label></div>
                    <div class="choix__option"><input class="saisie--case" type="radio" id="pa-10" name="prix_autocollants" value="jusqu-10"><label for="pa-10">Jusqu’à 10&nbsp;€</label></div>
                    <div class="choix__option"><input class="saisie--case" type="radio" id="pa-15" name="prix_autocollants" value="jusqu-15"><label for="pa-15">Jusqu’à 15&nbsp;€</label></div>
                    <div class="choix__option"><input class="saisie--case" type="radio" id="pa-plus" name="prix_autocollants" value="plus-15"><label for="pa-plus">Plus de 15&nbsp;€</label></div>
                  </div>
                </fieldset>
                <fieldset class="champ">
                  <legend class="champ__intitule">Pour un clavier gravé</legend>
                  <div class="choix">
                    <div class="choix__option"><input class="saisie--case" type="radio" id="pc-40" name="prix_clavier" value="jusqu-40"><label for="pc-40">Jusqu’à 40&nbsp;€</label></div>
                    <div class="choix__option"><input class="saisie--case" type="radio" id="pc-70" name="prix_clavier" value="jusqu-70"><label for="pc-70">Jusqu’à 70&nbsp;€</label></div>
                    <div class="choix__option"><input class="saisie--case" type="radio" id="pc-100" name="prix_clavier" value="jusqu-100"><label for="pc-100">Jusqu’à 100&nbsp;€</label></div>
                    <div class="choix__option"><input class="saisie--case" type="radio" id="pc-plus" name="prix_clavier" value="plus-100"><label for="pc-plus">Plus de 100&nbsp;€</label></div>
                  </div>
                </fieldset>
              </div>
            </fieldset>

            <fieldset class="formulaire__groupe">
              <legend class="formulaire__legende">Pour une organisation</legend>
              <div class="champ">
                <label class="champ__intitule" for="profil">Vous demandez</label>
                <select class="saisie saisie--liste" id="profil" name="profil">
                  <option value="">Choisir…</option>
                  <option value="particulier">Pour moi</option>
                  <option value="ecole">Pour une école</option>
                  <option value="entreprise">Pour une entreprise</option>
                  <option value="administration">Pour une administration</option>
                  <option value="association">Pour une association</option>
                </select>
              </div>
              <div class="formulaire__rangee">
                <div class="champ">
                  <label class="champ__intitule" for="organisation">Nom de l’organisation</label>
                  <input class="saisie" type="text" id="organisation" name="organisation" maxlength="120" autocomplete="organization">
                </div>
                <div class="champ">
                  <label class="champ__intitule" for="postes">Nombre de postes à équiper</label>
                  <input class="saisie" type="number" id="postes" name="postes" min="1" max="100000" step="1" inputmode="numeric">
                </div>
              </div>
            </fieldset>

            <fieldset class="formulaire__groupe">
              <legend class="formulaire__legende">Pour vous prévenir</legend>
              <div class="formulaire__rangee">
                <div class="champ">
                  <label class="champ__intitule" for="email">Votre e-mail</label>
                  <input class="saisie" type="email" id="email" name="email" autocomplete="email" required maxlength="254" aria-describedby="email-aide" placeholder="vous@example.org">
                  <p class="champ__aide" id="email-aide">Un seul message, quand les autocollants ou le clavier seront disponibles.</p>
                </div>
                <div class="champ">
                  <label class="champ__intitule" for="pays">Pays</label>
                  <select class="saisie saisie--liste" id="pays" name="pays" required>
                    <option value="">Choisir…</option>
                    <optgroup label="Europe et Amérique du Nord">
                      <option value="FR">France</option>
                      <option value="BE">Belgique</option>
                      <option value="CH">Suisse</option>
                      <option value="LU">Luxembourg</option>
                      <option value="MC">Monaco</option>
                      <option value="CA">Canada</option>
                    </optgroup>
                    <optgroup label="Afrique">
                      <option value="DZ">Algérie</option>
                      <option value="BJ">Bénin</option>
                      <option value="BF">Burkina Faso</option>
                      <option value="BI">Burundi</option>
                      <option value="CM">Cameroun</option>
                      <option value="CF">Centrafrique</option>
                      <option value="KM">Comores</option>
                      <option value="CG">Congo</option>
                      <option value="CD">Congo (RDC)</option>
                      <option value="CI">Côte d’Ivoire</option>
                      <option value="DJ">Djibouti</option>
                      <option value="GA">Gabon</option>
                      <option value="GN">Guinée</option>
                      <option value="MG">Madagascar</option>
                      <option value="ML">Mali</option>
                      <option value="MA">Maroc</option>
                      <option value="MU">Maurice</option>
                      <option value="MR">Mauritanie</option>
                      <option value="NE">Niger</option>
                      <option value="RW">Rwanda</option>
                      <option value="SN">Sénégal</option>
                      <option value="TD">Tchad</option>
                      <option value="TG">Togo</option>
                      <option value="TN">Tunisie</option>
                    </optgroup>
                    <optgroup label="Ailleurs">
                      <option value="HT">Haïti</option>
                      <option value="ZZ">Autre pays</option>
                    </optgroup>
                  </select>
                </div>
              </div>
              <div class="champ champ--case">
                <input class="saisie--case" type="checkbox" id="consentement" name="consentement" value="oui" required>
                <label class="champ__intitule" for="consentement">J’accepte que l’AMCF garde mon adresse pour me prévenir de leur disponibilité.</label>
              </div>
            </fieldset>

            <div class="formulaire__envoi">
              <button type="submit" class="bouton bouton--primaire">Me prévenir</button>
              <p class="texte-petit texte-2 formulaire__mention">
                Les fabricants ne reçoivent que des totaux, jamais votre adresse. Données hébergées par
                Cloudflare dans l’Union européenne, effacées sur simple demande&nbsp;:
                <a href="/confidentialite#demandes">confidentialité</a>.
              </p>
            </div>
          </form>

          {# Révélé par js/v2/formulaire.js après un envoi réussi. #}
          <div class="formulaire__fin" id="demandes-confirmation" hidden tabindex="-1">
            <div class="message message--succes">
              <strong class="message__titre">Votre demande est enregistrée</strong>
              <p>Merci. Nous vous écrirons une seule fois, quand les autocollants ou le clavier seront disponibles. Vous pouvez renvoyer le formulaire avec la même adresse pour changer vos réponses.</p>
            </div>
            <div class="etapes-suivantes">
              <a href="/download" class="etape-suivante">
                <strong>Télécharger AZERTY Global</strong>
                <p>Gratuit, sans attendre les autocollants</p>
              </a>
              <a href="/faq#stickers" class="etape-suivante">
                <strong>Imprimer ses autocollants</strong>
                <p>Les planches à imprimer chez soi</p>
              </a>
              <a href="/soutien" class="etape-suivante">
                <strong>Soutenir le projet</strong>
                <p>Contribuez à votre façon</p>
              </a>
            </div>
          </div>

          {# Révélé par js/v2/formulaire.js si la requête échoue. #}
          <div class="message message--erreur" id="demandes-echec" hidden tabindex="-1">
            <strong class="message__titre">La demande n’est pas partie</strong>
            <p>
              Vos réponses sont toujours dans le formulaire. Réessayez dans un instant&#8239;; si l’erreur
              revient, écrivez à
              <!--email_off--><a href="mailto:contact@azerty.global">contact@azerty.global</a><!--/email_off-->.
            </p>
          </div>
        </div>

        <aside class="ac-corps__cote carte ac-cote" aria-labelledby="cote-titre">
          <h2 class="ac-cote__titre" id="cote-titre">Ce que deviennent vos réponses</h2>
          <ol>
