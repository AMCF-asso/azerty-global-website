            </p>

            <fieldset class="formulaire__groupe">
              <legend class="formulaire__legende">Ce qui vous intéresse</legend>
              {# `required` est posé par js/v2/autocollants-claviers.js tant
                   qu'aucune carte n'est cochée : en HTML, il exigerait les deux. #}
              <div class="champ" data-erreur="Cochez au moins un des deux choix.">
                <span class="champ__intitule visuellement-cache">Ce qui vous intéresse</span>
                <div class="ac-produits">
                  <label class="ac-produit" for="p-autocollants">
                    <input class="saisie--case" type="checkbox" id="p-autocollants" name="produits" value="autocollants">
                    <span>
                      <span class="ac-produit__titre">Des autocollants de touches</span>
                      <span class="ac-produit__texte">Transparents, ils ajoutent les nouveaux caractères dans le coin libre de vos touches. Une pastille opaque couvre les rares touches qui changent.</span>
                    </span>
                    <span class="ac-produit__dessin" aria-hidden="true">
                      <span class="ac-touche ac-touche--noire"><span class="ac-touche__face"></span><span class="ac-glyphe ac-glyphe--grave">O</span><span class="ac-autocollant"><span class="ac-glyphe">œ</span></span></span>
                      <span class="ac-touche ac-touche--blanche"><span class="ac-touche__face"></span><span class="ac-pastille"><span class="ac-glyphe ac-glyphe--hg">#</span><span class="ac-glyphe ac-glyphe--bg">@</span><span class="ac-glyphe ac-glyphe--bd">→</span></span></span>
                    </span>
                  </label>
                  <label class="ac-produit" for="p-clavier">
                    <input class="saisie--case" type="checkbox" id="p-clavier" name="produits" value="clavier">
                    <span>
                      <span class="ac-produit__titre">Un clavier gravé AZERTY&nbsp;Global</span>
                      <span class="ac-produit__texte">Toutes les touches gravées d’origine, produit et vendu par un fabricant partenaire.</span>
                    </span>
                    <span class="ac-produit__dessin" aria-hidden="true">
                      <span class="ac-touche ac-touche--noire ac-touche--gravee"><span class="ac-touche__face"></span><span class="ac-glyphe ac-glyphe--grave">O</span><span class="ac-glyphe ac-g-bd">œ</span></span>
                    </span>
                  </label>
                </div>
              </div>
            </fieldset>

            <fieldset class="formulaire__groupe">
              <legend class="formulaire__legende">Votre clavier</legend>
              <div class="champ">
                <span class="champ__intitule" id="couleur-intitule">Couleur des touches</span>
                <div class="ac-couleurs" role="radiogroup" aria-labelledby="couleur-intitule">
                  <label class="ac-couleur"><input type="radio" name="couleur_touches" value="noires">
                    <span class="ac-couleur__pastille ac-couleur__pastille--noire" aria-hidden="true">œ</span>
                    <span class="ac-couleur__nom">Noires</span><span class="ac-couleur__aide">encre blanche</span></label>
                  <label class="ac-couleur"><input type="radio" name="couleur_touches" value="blanches">
                    <span class="ac-couleur__pastille ac-couleur__pastille--blanche" aria-hidden="true">œ</span>
                    <span class="ac-couleur__nom">Blanches</span><span class="ac-couleur__aide">encre noire</span></label>
                  <label class="ac-couleur"><input type="radio" name="couleur_touches" value="autre">
                    <span class="ac-couleur__pastille ac-couleur__pastille--autre" aria-hidden="true">autre</span>
                    <span class="ac-couleur__nom">Autre couleur</span></label>
                  <label class="ac-couleur"><input type="radio" name="couleur_touches" value="ne-sais-pas">
                    <span class="ac-couleur__pastille ac-couleur__pastille--autre" aria-hidden="true">?</span>
                    <span class="ac-couleur__nom">Je ne sais pas</span></label>
                </div>
              </div>
              <div class="formulaire__rangee">
                <div class="champ">
                  <label class="champ__intitule" for="disposition">Gravure actuelle</label>
                  <select class="saisie saisie--liste" id="disposition" name="disposition_physique">
