  <section class="hero-guide">
    <div class="conteneur">
      <h1>Prendre en main AZERTY Global</h1>
      <p class="hero-guide__definition">Tout ce qu’il faut savoir en 2&nbsp;minutes.</p>

      {#- La vérification n'existe que par le JS : sans lui, un champ qui ne
          répond à rien vaut moins que rien. Révélée par js/v2/guide.js. -#}
      <div class="verif" data-verif hidden
           data-verif-code="{{ verifInstallation.code }}"
           data-verif-cible="{{ verifInstallation.cible }}"
           data-verif-marquage="{{ verifInstallation.marquage }}"
           data-verif-signatures="{{ verifInstallation.signatures | dump }}"
           data-verif-code-qwerty="{{ verifInstallation.qwerty.code }}"
           data-verif-nom-qwerty="{{ verifInstallation.qwerty.nom }}">
        <label class="verif__intitule" for="verif-frappe">Déjà installé&nbsp;? Cliquez ici puis appuyez sur la touche marquée <kbd>{{ verifInstallation.marquage }}</kbd></label>
        <input class="verif__champ" id="verif-frappe" type="text" autocomplete="off" autocapitalize="off"
               spellcheck="false" aria-describedby="verif-verdict"
               data-track-conversion="guide_verification" data-track-detail-placement="guide-heros">
        <p class="verif__verdict" id="verif-verdict" role="status" data-verif-verdict></p>
      </div>
    </div>
  </section>

