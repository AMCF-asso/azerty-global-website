canonicalPath: "/feedback"
enPath: "/en/feedback"
ogType: "website"
ogDescription: "Un retour, une suggestion, un bug ? Dites-le en deux minutes : chaque message est lu."
bodyClass: "page-feedback"
robots: "index, follow"
extraStyles:
