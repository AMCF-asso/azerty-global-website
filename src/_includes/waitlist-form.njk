{#- Capture d’un e-mail pour les visiteurs qui n’installent pas tout de suite.
    Usage : {% set waitlistId = "home-waitlist" %}{% set waitlistPlacement = "home" %}{% include "waitlist-form.njk" %}
    Transport : js/web3forms.js (clé publique Web3Forms), repli mailto sous le bouton, aucun stockage côté site. -#}
<form id="{{ waitlistId }}" class="waitlist-form" data-waitlist data-fallback-email="feedback@azerty.global" novalidate>
  <h2 class="waitlist-title" id="{{ waitlistId }}-title">Pas le bon moment pour installer ?</h2>
  <p class="waitlist-text">Laissez un e-mail : nous vous renvoyons le lien d’installation, une seule fois. L’adresse ne sert qu’à cet envoi.</p>
  <div class="waitlist-row">
    <label class="waitlist-label" for="{{ waitlistId }}-email">Votre e-mail</label>
    <input type="email" id="{{ waitlistId }}-email" name="email" class="form-input" placeholder="votre@email.com" required autocomplete="email" inputmode="email" aria-describedby="{{ waitlistId }}-status">
    <button type="submit" class="btn btn--primary" data-track-conversion="waitlist_submit" data-track-detail-placement="{{ waitlistPlacement or 'page' }}">Recevoir le lien</button>
  </div>
  <input type="checkbox" name="botcheck" hidden tabindex="-1" aria-hidden="true" autocomplete="off">
  <input type="hidden" name="subject" value="Lien d’installation demandé – AZERTY Global">
  <input type="hidden" name="from_page" value="{{ canonicalPath or page.url }}">
  <p class="text-sm form-email-fallback waitlist-fallback">Ou écrivez à <!--email_off--><a href="mailto:feedback@azerty.global">feedback@azerty.global</a><!--/email_off-->.</p>
  <p class="waitlist-status" id="{{ waitlistId }}-status" role="status" aria-live="polite" tabindex="-1" hidden></p>
</form>
