{#- Guide typographique v2, partagé par /francais-correct et /en/french-typography
    (audit v2, décisions d'Antoine du 2026-09-24). Données : src/_data/typographyGuide.js.

    Un seul `.sommaire` (les chapitres et la FAQ) remplace les trois niveaux de
    navigation v1 (raccourcis, sommaire latéral, index de chapitre) et la barre
    fixe mobile (A252). Les ancres `<chapitre>-r<n>` restent : des liens entrants
    y pointent.

    Le layout v2 pose déjà le <main id="contenu-principal"> : ce bloc reste un <div>. -#}
<div class="guide-typo" data-guide-typo data-guide-lang="{{ guide.lang }}">
  <section class="hero-guide-typo">
    <div class="conteneur">
      <h1>{{ guide.title }}</h1>
      <p class="hero-guide-typo__definition">{{ guide.subtitle }}</p>
      <p class="hero-guide-typo__intro">{{ guide.intro }}</p>

      <figure class="specimen-typo">
        <figcaption class="visuellement-cache">{{ guide.specimenTitle }}</figcaption>
        <div class="paire-typo">
          <div class="exemple-typo exemple-typo--eviter">
            <p class="exemple-typo__etiquette">{{ guide.beforeLabel }}</p>
            <p class="exemple-typo__texte" lang="fr">{{ guide.beforeText }}</p>
          </div>
          <div class="exemple-typo exemple-typo--ecrire">
            <p class="exemple-typo__etiquette">{{ guide.afterLabel }}</p>
            <p class="exemple-typo__texte" lang="fr">{{ guide.afterText }}</p>
          </div>
        </div>
        <p class="specimen-typo__corrections texte-petit texte-2">{{ guide.correctionsLabel | safe }} {{ guide.corrections | join(' · ') }}</p>
      </figure>

      <p class="hero-guide-typo__actions">
        <button type="button" class="bouton bouton--secondaire" data-guide-imprimer>{{ guide.printLabel }}</button>
        <a class="texte-petit" href="#sources">{{ guide.updatedLabel }}</a>
      </p>

      <nav class="sommaire" aria-label="{{ guide.tocLabel }}">
        {%- for chapter in guide.chapters %}
        <a class="sommaire__chip" href="#{{ chapter.id }}">{{ chapter.shortTitle }}</a>
        {%- endfor %}
        <a class="sommaire__chip" href="#questions-frequentes">{{ guide.faqTitle }}</a>
      </nav>
    </div>
  </section>

  <div class="section section--suite-heros">
    <div class="conteneur">
      <article class="mesure-lecture guide-typo__article">
        {%- for chapter in guide.chapters %}
        <section class="chapitre-typo" id="{{ chapter.id }}" aria-labelledby="{{ chapter.id }}-titre">
          <h2 id="{{ chapter.id }}-titre">{{ chapter.title }}</h2>
          <p class="chapitre-typo__chapeau">{{ chapter.lead }}</p>

          {%- for rule in chapter.rules %}
          <section class="regle-typo" id="{{ chapter.id }}-r{{ loop.index }}">
            <h3><a href="#{{ chapter.id }}-r{{ loop.index }}">{{ rule.title }}</a></h3>
            <div class="prose">{{ rule.summary | safe }}</div>

            {%- if rule.bad or rule.good %}
            <div class="paire-typo">
              <div class="exemple-typo exemple-typo--eviter">
                <p class="exemple-typo__etiquette">{{ guide.avoidLabel }}</p>
                <p class="exemple-typo__texte" lang="{{ rule.badLang or rule.exampleLang or chapter.exampleLang or guide.lang }}">{{ rule.bad | safe }}</p>
              </div>
              <div class="exemple-typo exemple-typo--ecrire">
                <p class="exemple-typo__etiquette">{{ guide.preferLabel }}</p>
                <p class="exemple-typo__texte" lang="{{ rule.goodLang or rule.exampleLang or chapter.exampleLang or guide.lang }}">{{ rule.good | safe }}</p>
              </div>
            </div>
            {%- endif %}

            {%- if rule.note %}
            <p class="regle-typo__note texte-petit texte-2">{{ rule.note | safe }}</p>
            {%- endif %}

            {%- if rule.advanced %}
            <details class="notice">
              <summary>{{ rule.advancedTitle or guide.advancedLabel }}</summary>
              <div class="notice__contenu prose">{{ rule.advanced | safe }}</div>
            </details>
            {%- endif %}
          </section>
          {%- endfor %}

          {%- if chapter.copies %}
          <div class="copies" role="group" aria-labelledby="{{ chapter.id }}-copies">
            <h3 id="{{ chapter.id }}-copies" class="copies__titre">{{ guide.copyPaletteLabel }}</h3>
            <p class="copies__aide texte-petit texte-2">{{ guide.copyPaletteHint }}</p>
            <div class="copies__grille">
              {%- for item in chapter.copies %}
              <button type="button" class="copie" data-copier="{{ item.value }}" data-copier-id="{{ item.id }}" aria-label="{{ item.ariaLabel }}">
                <span class="copie__glyphe" aria-hidden="true">{{ item.display | safe }}</span>
                <span class="copie__nom" data-copier-libelle>{{ item.label }}</span>
              </button>
              {%- endfor %}
            </div>
            <p class="visuellement-cache" role="status" data-copier-statut></p>
          </div>
          {%- endif %}
        </section>
        {%- endfor %}

        <section class="chapitre-typo" id="questions-frequentes" aria-labelledby="questions-frequentes-titre">
          <h2 id="questions-frequentes-titre">{{ guide.faqTitle }}</h2>
          <p class="chapitre-typo__chapeau">{{ guide.faqLead }}</p>
          {%- for item in guide.faq %}
          <details class="notice">
            <summary>{{ item.question }}</summary>
            <div class="notice__contenu prose"><p>{{ item.answer | safe }}</p></div>
          </details>
          {%- endfor %}
        </section>

        <section class="chapitre-typo" id="sources" aria-labelledby="sources-titre">
          <h2 id="sources-titre">{{ guide.sourcesTitle }}</h2>
          <p class="chapitre-typo__chapeau">{{ guide.sourcesLead }}</p>
          <ul class="sources-typo">
            {%- for source in guide.sources %}
            <li>{{ source | safe }}</li>
            {%- endfor %}
          </ul>
          <p class="texte-petit texte-2">
            <strong>{{ guide.reviewedLabel }}</strong> {{ guide.reviewedDate }} ·
            <a href="{{ guide.feedbackUrl }}">{{ guide.feedbackLabel }}</a>
          </p>
        </section>
      </article>
    </div>
  </div>

  {#- A183 : cartes de sortie du référentiel à la place de la carte v1 centrée.
      « Imprimer le guide » est un bouton : il n'ouvre pas de page. -#}
  <section class="section guide-typo__suite" aria-labelledby="guide-typo-suite-titre">
    <div class="conteneur">
      <h2 id="guide-typo-suite-titre">{{ guide.nextTitle | safe }}</h2>
      <div class="etapes-suivantes">
        {%- for step in guide.nextSteps %}
        {%- if step.print %}
        <button type="button" class="etape-suivante" data-guide-imprimer>
          <strong>{{ step.title }}</strong>
          <p>{{ step.text }}</p>
        </button>
        {%- else %}
        <a href="{{ step.href }}" class="etape-suivante"{% if step.conversion %} data-track-conversion="{{ step.conversion }}" data-track-detail-source="typography-final" data-track-detail-language="{{ guide.lang }}"{% endif %}>
          <strong>{{ step.title }}</strong>
          <p>{{ step.text }}</p>
        </a>
        {%- endif %}
        {%- endfor %}
      </div>
    </div>
  </section>

  <p class="guide-typo__adresse">{{ guide.printUrlLabel }} {{ guide.absoluteUrl }}</p>
</div>
