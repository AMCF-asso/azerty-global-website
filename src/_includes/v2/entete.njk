{# Refonte — en-tête réel, décisions du 2026-08-27 §1
   (operations/refonte-site/2026-08-27-decisions-navigation-et-pages.md).

   FR : Logo · Testeur · Comparatif · Afrique · Aide ▾ · Organisations ▾ ·
        Association ▾ · [Télécharger] · FR/EN · thème
        Astuces est passée dans Aide ▾ le 2026-08-27 (demande d'Antoine,
        révision du §1 qui la plaçait en premier niveau).
   EN : adapté, pas miroir — pas d'Organizations ▾ (Business en lien direct),
        pas de Tips tant que les pages caractère restent FR-only.

   Le mot « Association » reste visible en permanence dans la barre : exigence
   Google Ad Grants. Le déroulant qui le porte est un bouton de menu ordinaire,
   pas un lien hybride.

   Marque : le logo actuel (touches noires), décision D20 de la roadmap refonte
   (2026-09-01) — il reste jusqu'au logo v2 fait avec Corentin après la bascule
   (session F3). En thème sombre, css/v2/shell.css lui applique le filtre du
   jeton --filtre-logo (session T1, 2026-09-02). Le wordmark texte qui le
   précédait a disparu du shell. #}

<header class="entete">
  <div class="conteneur entete__inner">
    <a href="/{% if pageLocale == 'en' %}en/{% endif %}" class="entete__marque" aria-label="AZERTY Global — {% if pageLocale == 'en' %}home{% else %}accueil{% endif %}">
      <picture>
        <source srcset="/assets/logo-azerty-global-header.webp" type="image/webp">
        <img src="/assets/logo-azerty-global-header.png" alt="AZERTY Global" class="entete__logo" width="480" height="250" decoding="async">
      </picture>
    </a>

    <button class="entete__menu-bouton" aria-expanded="false" aria-controls="nav-principale" data-menu-bouton>Menu</button>

    {#- Page en cours : aria-current="page" sur son lien, et le déroulant qui
        la contient porte nav-groupe--actif (2026-09-24). page.url vaut
        « /afrique.html » ou « /testeur/ » selon le permalink : on normalise. #}
    {%- set ici = page.url | replace(r/\.html$/, "") | replace(r/(.)\/$/, "$1") %}
    {%- macro lien(href, texte, classe, ici) -%}
      <a href="{{ href }}"{% if classe %} class="{{ classe }}"{% endif %}{% if href == ici %} aria-current="page"{% endif %}>{{ texte }}</a>
    {%- endmacro %}
    {%- macro groupe(titre, liens, ici) -%}
      <details class="nav-groupe{% for l in liens %}{% if l[0] == ici %} nav-groupe--actif{% endif %}{% endfor %}">
        <summary>{{ titre }}</summary>
        <ul class="nav-groupe__liste">
          {%- for l in liens %}
          <li>{{ lien(l[0], l[1], "", ici) }}</li>
          {%- endfor %}
        </ul>
      </details>
    {%- endmacro %}

    {%- if pageLocale == "en" %}
    <nav id="nav-principale" class="nav-principale" aria-label="Main navigation">
      {{ lien("/en/tester", "Tester", "nav-principale__lien", ici) }}
      {{ lien("/en/comparison", "Comparison", "nav-principale__lien", ici) }}
      {{ groupe("Help", [["/en/guide", "Guide"], ["/en/faq", "FAQ"], ["/en/contact", "Contact"]], ici) }}
      {{ lien("/en/business", "Business", "nav-principale__lien", ici) }}
      {{ groupe("Association", [["/en/association", "The AMCF"], ["/en/support", "Support us"], ["/en/press", "Press"], ["/en/about", "About the project"]], ici) }}
    </nav>
    {%- else %}
    <nav id="nav-principale" class="nav-principale" aria-label="Navigation principale">
      {#- Pré-bascule : /astuces et /administrations n'existent pas encore (P4), D44. -#}
      {{ lien("/testeur", "Testeur", "nav-principale__lien", ici) }}
      {{ lien("/comparatif", "Comparatif", "nav-principale__lien", ici) }}
      {{ lien("/afrique", "Afrique", "nav-principale__lien", ici) }}
      {{ groupe("Aide", [["/guide", "Guide"], ["/faq", "FAQ"], ["/contact", "Contact"]], ici) }}
      {{ groupe("Organisations", [["/entreprises", "Entreprises"], ["/ecoles", "Écoles"]], ici) }}
      {{ groupe("Association", [["/association", "L’AMCF"], ["/soutien", "Soutenir"], ["/presse", "Presse"], ["/a-propos", "À propos du projet"]], ici) }}
    </nav>
    {%- endif %}

    {#- Sur la page de téléchargement elle-même, le CTA devient secondaire et
        porte aria-current : deux aplats primaires se disputaient la première
        vue, et le lien renvoyait à la page courante (lot 7, A167). #}
    {%- set cibleTelechargement = "/en/download" if pageLocale == "en" else "/download" %}
    {%- set surTelechargement = (ici == cibleTelechargement) %}
    <a href="{{ cibleTelechargement }}" class="bouton {% if surTelechargement %}bouton--secondaire{% else %}bouton--primaire{% endif %} entete__cta"{% if surTelechargement %} aria-current="page"{% endif %}>{% if pageLocale == "en" %}Download{% else %}Télécharger{% endif %}</a>

    <div class="entete__outils">
      {% include "v2/langues.njk" %}
      {% include "v2/bascule-theme.njk" %}
    </div>
  </div>
</header>
