        <li><a href="https://sourceforge.net/projects/azertyglobal/" target="_blank" rel="noopener noreferrer">SourceForge</a></li>
      </ul>
    </div>
    </div>

    <div class="pied__bas">
      {%- if pageLocale == "en" %}
      <p class="pied__droits">© 2017–2026 <a href="/en/association">AMCF</a>, a French nonprofit (association loi 1901, RNA W632015664)</p>
      <ul class="pied__cadre">
