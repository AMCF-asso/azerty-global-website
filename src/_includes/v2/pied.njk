        </a>
        <a href="/{% if pageLocale == 'en' %}en/{% endif %}association" class="pied__logo">
          <picture>
            <source srcset="/assets/logo-amcf-320.webp" type="image/webp">
            <img src="/assets/logo-amcf-320.png" alt="{% if pageLocale == 'en' %}AMCF, the nonprofit behind AZERTY Global{% else %}AMCF, l’association qui porte AZERTY Global{% endif %}" width="48" height="48" loading="lazy" decoding="async">
