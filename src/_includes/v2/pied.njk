        <li><a href="/en/privacy">Privacy</a></li>
        <li><a href="/accessibilite" lang="fr" hreflang="fr">Accessibility</a></li>
        <li><a href="/licence" lang="fr" hreflang="fr">Licence</a></li>
      </ul>
      {%- else %}
      <p class="pied__droits">© 2017–2026 <a href="/association">AMCF</a>, association loi 1901 (RNA W632015664)</p>
      <ul class="pied__cadre">
        <li><a href="/mentions-legales">Mentions légales</a></li>
        <li><a href="/confidentialite">Confidentialité</a></li>
        <li><a href="/accessibilite">Accessibilité</a></li>
        <li><a href="/licence">Licence</a></li>
      </ul>
      {%- endif %}
