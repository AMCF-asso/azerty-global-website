    "OKLM_siteView": {
      "_lisezmoi": "Ce que la vue data/AZERTY Global.json porte et que le coeur OKLM 0.1 ne modelise pas : prose editoriale, groupement en rangees, correspondance materielle (scancode, code virtuel) et exemples des touches mortes. Le reste de la vue est genere depuis le coeur du manifeste.",
      "tete": {
        "author": "Microsoft",
        "standard": "ISO",
        "country": "France",
        "locale_id": "0000040C",
        "description": "The traditional French AZERTY keyboard layout as implemented in Microsoft Windows since Windows 95. This is the standard layout found on most French keyboards.",
        "history": {
          "origin": "The AZERTY layout was developed in France in the late 19th century for typewriters, adapted from the American QWERTY layout",
          "windows_version": "Included in Windows since Windows 95 (1995)",
          "limitations": [
            "No direct access to É, È, Ç, À (must use Caps Lock workaround or dead keys)",
            "Limited AltGr layer with few useful characters",
            "Caps Lock acts as Shift Lock (swaps base and shift for ALL keys, not just letters)",
            "Programming symbols require awkward key combinations"
          ]
        },
        "conventions": {
          "caps_lock_behavior": "Caps Lock acts as Shift Lock: swaps base and shift states for ALL keys including numbers and symbols",
          "caps": "With Caps Lock ON, produces the shift value",
          "caps_shift": "With Caps Lock ON + Shift, produces the base value",
          "null_meaning": "No output for this key combination"
        }
      },
