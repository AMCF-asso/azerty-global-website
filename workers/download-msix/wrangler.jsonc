{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "azerty-global-downloads",
  "main": "src/index.js",
  "no_bundle": true,
  "compatibility_date": "2026-07-01",
  "workers_dev": false,
  "limits": {
    "cpu_ms": 50
  },
  "routes": [
    {
      "pattern": "download.azerty.global",
      "custom_domain": true
    }
  ],
  "r2_buckets": [
    {
      "binding": "DOWNLOADS",
      "bucket_name": "azerty-global-downloads"
    }
  ],
  "analytics_engine_datasets": [
    {
      "binding": "DOWNLOAD_STATS",
      "dataset": "azerty_global_downloads"
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": {
      "invocation_logs": false
    }
  }
}
